{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/worker/**",
      "/lib/**",
      "/prisma/**",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.json",
      "/Dockerfile",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run worker",
    "restartPolicyType": "ON_FAILURE"
  }
}
